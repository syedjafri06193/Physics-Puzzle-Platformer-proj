[configuration]
entry_symbol = "ppp_library_init"
compatibility_minimum = "4.2"

[libraries]
linux.debug.x86_64   = "res://bin/libppp.so"
linux.release.x86_64 = "res://bin/libppp.so"
windows.debug.x86_64   = "res://bin/ppp.dll"
windows.release.x86_64 = "res://bin/ppp.dll"
macos.debug   = "res://bin/libppp.dylib"
macos.release = "res://bin/libppp.dylib"
